{
  "name": "machiawase-qr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "deploy:dry": "wrangler deploy --dry-run --env staging",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "hono": "4.13.5",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260829.1",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
